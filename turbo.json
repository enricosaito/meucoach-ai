{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "AI_*",
        "ANTHROPIC_*",
        "INNGEST_*",
        "LOG_LEVEL",
        "RATE_LIMIT_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:integration": {
      "cache": false
    }
  }
}
