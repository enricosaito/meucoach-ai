# Copy to apps/web/.env.local (or run `pnpm env:setup`, which fills in the Supabase values).
# Next.js loads env files from apps/web. Never commit real keys.

# --- Supabase (local values come from `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe for browsers. RLS limits clients to reading their own rows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: SERVER ONLY. Bypasses RLS. Never expose it to a client.
SUPABASE_SECRET_KEY=

# --- AI ---
# mock (default, free, deterministic) | anthropic (real Claude calls)
AI_PROVIDER=mock
# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model overrides per tier.
# fast  = interactive coach chat     (default: claude-sonnet-5-5)
# smart = workout plans + photo analysis (default: claude-opus-5-5)
# Cheapest setup for testing: AI_MODEL_FAST=claude-haiku-5-5 (and optionally the same for smart).
AI_MODEL_FAST=
AI_MODEL_SMART=
# Artificial latency for the mock provider, in ms
AI_MOCK_DELAY_MS=400

# --- API ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Per-user request limits (in-memory locally; swap for a shared store in production)
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=10

# Browser origins allowed to call the API cross-origin. Local: the Expo web dev server.
API_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# --- Background jobs (Inngest) ---
# Local: 1 = use the Inngest Dev Server that `pnpm dev` starts (UI at http://localhost:8288).
# Production: remove INNGEST_DEV and set INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY
# (Vercel Marketplace: Inngest integration).
INNGEST_DEV=1
